+#ifdef WINE_IOS
+/***********************************************************************
+ *           ios_disc_root
+ *
+ * iOS-Madeira (marik): disc images. The app unpacks an ISO into
+ * <config_dir>/discs/<name> and points dosdevices/<letter>: at it. Without a
+ * mount manager the volume would answer as a fixed NTFS disk with no label, so
+ * a file under that tree is reported as a CD-ROM with the CDFS file system and
+ * the label and serial the app wrote into .windows-label / .windows-serial at
+ * the disc root. Writes root (without a trailing slash) and returns TRUE when
+ * fd is on such a disc.
+ */
+static BOOL ios_disc_root( int fd, char *root, size_t size )
+{
+    static char discs[PATH_MAX];
+    static size_t discs_len;
+    char path[PATH_MAX], *end;
+
+    if (!discs_len)
+    {
+        char tmp[PATH_MAX];
+        snprintf( tmp, sizeof(tmp), "%s/discs", config_dir );
+        if (!realpath( tmp, discs )) return FALSE;
+        discs_len = strlen( discs );
+    }
+    if (fcntl( fd, F_GETPATH, path ) == -1) return FALSE;
+    if (strncmp( path, discs, discs_len ) || path[discs_len] != '/' || !path[discs_len + 1]) return FALSE;
+    end = strchr( path + discs_len + 1, '/' );
+    if (end) *end = 0;
+    if (strlen( path ) >= size) return FALSE;
+    strcpy( root, path );
+    return TRUE;
+}
+
+static size_t ios_disc_read( const char *root, const char *name, char *buf, size_t size )
+{
+    char path[PATH_MAX];
+    ssize_t n;
+    int f;
+
+    snprintf( path, sizeof(path), "%s/%s", root, name );
+    if ((f = open( path, O_RDONLY )) == -1) return 0;
+    n = read( f, buf, size - 1 );
+    close( f );
+    if (n < 0) n = 0;
+    while (n && (buf[n - 1] == '\n' || buf[n - 1] == '\r' || buf[n - 1] == ' ')) n--;
+    buf[n] = 0;
+    return n;
+}
+#endif
